# ════════════════════════════════════════════════════════════════════════════════
# Seria Project - Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Seria is a desktop app, so most configuration is handled by tauri.conf.json,
# but we use .env for Vite configuration and development settings.
# ════════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────────
# Application Configuration
# ────────────────────────────────────────────────────────────────────────────────

# Application name and version (should match tauri.conf.json)
VITE_APP_NAME=Seria
VITE_APP_VERSION=0.0.2

# Environment mode (development, production)
NODE_ENV=development

# ────────────────────────────────────────────────────────────────────────────────
# Development Server Configuration
# ────────────────────────────────────────────────────────────────────────────────

# Vite development server port (used when running `npm run dev`)
# Tauri's dev mode automatically proxies to this port
VITE_PORT=5173

# Hostname for Vite dev server
VITE_HOST=localhost

# ────────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ────────────────────────────────────────────────────────────────────────────────

# Enable debug logging (verbose console output)
VITE_DEBUG=true

# Enable telemetry/analytics (for future use)
VITE_ENABLE_TELEMETRY=false

# Enable experimental features (editable Prints, etc.)
VITE_ENABLE_EXPERIMENTAL=false

# ────────────────────────────────────────────────────────────────────────────────
# External Resources
# ────────────────────────────────────────────────────────────────────────────────

# Path to Common repository (shared standards and documentation)
COMMON_REPO=~/Common

# ────────────────────────────────────────────────────────────────────────────────
# Tauri Configuration
# ────────────────────────────────────────────────────────────────────────────────

# Note: Most Tauri configuration lives in src-tauri/tauri.conf.json
# including window size, permissions, and app metadata.
# Only Vite-specific and development settings belong in this .env file.

# ────────────────────────────────────────────────────────────────────────────────
# CSV Editor Configuration
# ────────────────────────────────────────────────────────────────────────────────

# Maximum CSV file size in MB (for warning users about large files)
VITE_MAX_CSV_SIZE_MB=50

# Virtualization threshold (number of rows before enabling virtualization)
VITE_VIRTUALIZATION_THRESHOLD=1000

# ────────────────────────────────────────────────────────────────────────────────
# Print System Configuration
# ────────────────────────────────────────────────────────────────────────────────

# Default print template ID (from bundled prints)
VITE_DEFAULT_PRINT=screenplay

# Enable custom print templates
VITE_ENABLE_CUSTOM_PRINTS=true

# ────────────────────────────────────────────────────────────────────────────────
# GitLab Package Registry Configuration
# ────────────────────────────────────────────────────────────────────────────────

# GitLab project ID (found in project settings > General)
GITLAB_PROJECT_ID=your_project_id_here

# GitLab private access token with api scope (create at User Settings > Access Tokens)
GITLAB_PRIVATE_TOKEN=your_access_token_here

# GitLab package name (used in the generic package registry)
GITLAB_PACKAGE_NAME=seria

# GitLab username and project name (for stable package URLs)
GITLAB_USERNAME=your_gitlab_username
GITLAB_PROJECT_NAME=YourProjectName
