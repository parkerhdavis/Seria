{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Juniper",
    "version": "0.1.0",
    "identifier": "com.juniper.app",
    "build": {
        "devUrl": "http://localhost:5173",
        "frontendDist": "../frontend/dist",
        "beforeBuildCommand": "cd ../frontend && npm run build"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon@2x.png",
            "icons/icon.png"
        ]
    },
    "app": {
        "windows": [
            {
                "title": "Juniper - CSV Editor",
                "width": 1400,
                "height": 900,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {}
}
