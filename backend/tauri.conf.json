{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Juniper",
    "version": "0.1.0",
    "identifier": "com.juniper.csveditor",
    "build": {
        "devUrl": "http://localhost:5173",
        "frontendDist": "../frontend/dist"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon@2x.png",
            "icons/icon.png"
        ]
    },
    "app": {
        "windows": [
            {
                "title": "Juniper - CSV Editor",
                "width": 1400,
                "height": 900,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null,
            "capabilities": [
                {
                    "identifier": "main-capability",
                    "windows": ["*"],
                    "permissions": [
                        "dialog:allow-open",
                        "dialog:allow-save",
                        "fs:allow-read-text-file",
                        "fs:allow-write-text-file",
                        "fs:allow-read-file",
                        "fs:allow-write-file",
                        "fs:allow-read-dir",
                        "clipboard-manager:allow-read-text",
                        "clipboard-manager:allow-write-text"
                    ]
                }
            ]
        }
    },
    "plugins": {}
}
