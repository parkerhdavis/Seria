# ════════════════════════════════════════════════════════════════════════════════
# Seria Project - Git Ignore Configuration
# ════════════════════════════════════════════════════════════════════════════════

# Environment & Secrets (NEVER commit)
.env
.env.local
.env.*.local

# Dependencies (hoisted root node_modules via Bun workspaces)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Build Artifacts & Distribution
# Rust/Tauri — routed via apps/desktop/backend/.cargo/config.toml
target/
**/*.rs.bk
*.pdb
apps/desktop/backend/WixTools/
apps/desktop/backend/gen/

# Frontend bundle
apps/desktop/frontend/dist/

# TypeScript
*.tsbuildinfo

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
.dev.pid

# Testing & Coverage
coverage/
.nyc_output/

# IDE & Editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.directory

# Documentation & Development Tools
wiki-internal/
.obsidian
*.local
