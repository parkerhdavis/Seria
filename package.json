{
	"name": "seria",
	"version": "0.1.0",
	"description": "Seria — multimodal serialized-data editor for game writers and narrative designers",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*"],
	"scripts": {
		"build:view": "bun apps/desktop/frontend/build.ts",
		"build": "bun run build:view",
		"start": "bun run build:view && cd apps/desktop && bunx electrobun dev",
		"dev": "ELECTROBUN_DEV=1 bun run build:view && cd apps/desktop && bunx electrobun dev --watch",
		"test": "bun test",
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0",
		"format": "prettier --write \"apps/**/*.{ts,tsx,css}\""
	},
	"dependencies": {
		"@tanstack/react-table": "^8.11.2",
		"@tanstack/react-virtual": "^3.0.1",
		"@types/html2pdf.js": "^0.10.0",
		"electrobun": "latest",
		"html2canvas": "^1.4.1",
		"html2pdf.js": "^0.14.0",
		"jspdf": "^4.0.0",
		"loglevel": "^1.9.2",
		"papaparse": "^5.4.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"zustand": "^4.4.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@types/bun": "latest",
		"@types/node": "^20.10.6",
		"@types/papaparse": "^5.3.14",
		"@types/react": "^18.2.46",
		"@types/react-dom": "^18.2.18",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"bun-plugin-tailwind": "latest",
		"daisyui": "^5.4.7",
		"eslint": "^9.17.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.5",
		"globals": "^15.13.0",
		"prettier": "^3.1.1",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.18.2"
	}
}
